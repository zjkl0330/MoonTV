# Cloudflare Pages 环境变量配置
# 在 Cloudflare 控制台 -> Pages -> moon -> Settings -> Environment Variables 中添加

# === 必需的变量 ===
PASSWORD=your_password
USERNAME=admin
NEXT_PUBLIC_STORAGE_TYPE=d1

# === 站点配置 ===
SITE_NAME=MoonTV
ANNOUNCEMENT=本网站仅提供影视信息搜索服务，所有内容均来自第三方网站。本站不存储任何视频资源，不对任何内容的准确性、合法性、完整性负责。

# === 功能开关 ===
NEXT_PUBLIC_ENABLE_REGISTER=false
NEXT_PUBLIC_DISABLE_YELLOW_FILTER=false

# === 搜索配置 ===
NEXT_PUBLIC_SEARCH_MAX_PAGE=5

# === 可选：代理配置（如需要）===
# NEXT_PUBLIC_IMAGE_PROXY=https://your-proxy.com/proxy/
# NEXT_PUBLIC_DOUBAN_PROXY=https://your-proxy.com/douban/

# === 可选：B 站资源（第三方聚合）===
# BILIBILI_RELAY=https://your-bili-relay.example.com
# BILIBILI_RELAY_KEY=your_key
# 第三方返回的媒体域名不在 B 站 CDN 白名单时，需要显式加入
# BILIBILI_STREAM_HOSTS=cdn.example.com
# 直连官方接口（成功率较低）
# BILIBILI_COOKIE=your_cookie
# BILIBILI_DIRECT=true